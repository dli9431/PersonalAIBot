# ── Required ──────────────────────────────────────────────────────────────────

DISCORD_TOKEN=your-bot-token-here
ALLOWED_USER_ID=123456789012345678
REPO_PATH=/home/you/code/my-app

# ── Additional repos ──────────────────────────────────────────────────────────
# Comma-separated paths to other git repos the bot can commit/push to.
# Each entry: "path" or "label:path" (relative to REPO_PATH or absolute).
# Project 1 is always REPO_PATH. Additional repos start at project 2.
# GIT_PROJECTS=MyApp:../my-app,/home/you/other-repo

# ── Branches ──────────────────────────────────────────────────────────────────

BRANCH_PREFIX=auto
MAIN_BRANCH=main
DEV_BRANCH=dev

# ── Engine ────────────────────────────────────────────────────────────────────

# Default when no prefix used: "claude" or "codex"
DEFAULT_ENGINE=claude
ENGINE_TIMEOUT=300

# ── Claude Code ───────────────────────────────────────────────────────────────

CLAUDE_MODEL=sonnet
CLAUDE_ALLOWED_TOOLS=Read Edit Write Grep Glob LS Bash(git\ diff) Bash(git\ status)
CLAUDE_DENIED_TOOLS=Bash(rm\ *) Bash(sudo\ *) Bash(curl\ *) Bash(wget\ *) WebFetch

# ── Codex CLI ─────────────────────────────────────────────────────────────────

CODEX_MODEL=gpt-5.3-codex
# Sandbox + approval policy are set in ~/.codex/config.toml, not here.
# See codex-config-example.toml.
