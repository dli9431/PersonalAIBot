# ── Required ──────────────────────────────────────────────────────────────────

DISCORD_TOKEN=your-bot-token-here
ALLOWED_USER_ID=123456789012345678
REPO_PATH=/home/you/code/my-app

# ── Additional repos ──────────────────────────────────────────────────────────
# Comma-separated paths to other git repos the bot can commit/push to.
# Each entry: "path" or "label:path" (relative to REPO_PATH or absolute).
# Project 1 is always REPO_PATH. Additional repos start at project 2.
# GIT_PROJECTS=MyApp:../my-app,/home/you/other-repo

# ── Branches ──────────────────────────────────────────────────────────────────

BRANCH_PREFIX=auto
MAIN_BRANCH=main
DEV_BRANCH=dev
PROTECTED_BRANCHES=main,dev

# ── Engine ────────────────────────────────────────────────────────────────────

# Default when no prefix used: "claude", "codex", or "kimi"
DEFAULT_ENGINE=claude
# Seconds without engine stdout/stderr before the run is auto-resumed.
ENGINE_TIMEOUT=300
CONTEXT_MAX_CHARS=4000
PLAN_CONTEXT_MAX_CHARS=12000

# ── Claude Code ───────────────────────────────────────────────────────────────

CLAUDE_MODEL=sonnet
# Optional: low | medium | high (unset = CLI default)
# CLAUDE_REASONING_EFFORT=
CLAUDE_ALLOWED_TOOLS=Read Edit Write Grep Glob LS Bash(git\ diff) Bash(git\ status)
CLAUDE_DENIED_TOOLS=Bash(rm\ *) Bash(sudo\ *) Bash(curl\ *) Bash(wget\ *) WebFetch

# ── Codex CLI ─────────────────────────────────────────────────────────────────

CODEX_MODEL=gpt-5.5
# Optional: minimal | low | medium | high | xhigh (unset = CLI default)
# CODEX_REASONING_EFFORT=
# Sandbox + approval policy are set in ~/.codex/config.toml, not here.
# See codex-config-example.toml.

# ── Kimi Code CLI ─────────────────────────────────────────────────────────────

KIMI_MODEL=kimi-code/k3
# Optional: low | medium | high | xhigh | max (unset = CLI default)
# KIMI_REASONING_EFFORT=
